    "test:app-agent-storage-e2e": "node scripts/test-app-agent-storage-e2e.mjs",
    "test:app-agent-deploy-verify": "node scripts/verify-app-agent-chat-deploy.mjs",
    "test:subagents-metadata-e2e": "node --import tsx scripts/test-subagents-metadata-e2e.ts",
    "setup:apps-dns": "node scripts/setup-apps-papr-ai-dns.mjs",
    "test:payload-migration": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-tool-payload-migration.mjs",
    "test:turso-auto-push": "ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-turso-auto-push.mjs",
    "test:turso-permanent-skip": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-turso-permanent-skip.mjs",
    "spike:turso-replica": "node scripts/spike-turso-embedded-replica.mjs",
    "test:replica-dogfood": "node scripts/test-replica-registry-dogfood.mjs",
    "test:replica-migration-cloud-e2e": "node scripts/test-replica-migration-cloud-e2e.mjs",
    "test:replica-extended": "node scripts/test-replica-extended-dogfood.mjs",
    "cutover:replica:dry-run": "npm run build:gateway && node scripts/cutover-replica.mjs --dry-run",
    "cutover:replica": "npm run build:gateway && node scripts/cutover-replica.mjs",
    "test:replica-cutover-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-replica-cutover-e2e.mjs",
    "test:replica-sidecar": "npx vitest run tests/turso-replica-checkpoint-recovery.test.ts tests/turso-replica-sidecar-wedge.test.ts tests/turso-replica-inbound-drain.test.ts tests/db-router.test.ts tests/turso-replica-phase2.test.ts --project unit-backend",
    "verify:replica-sidecar": "npm run build:gateway && node scripts/verify-replica-sidecar-health.mjs",
    "verify:replica-sidecar:repair": "npm run build:gateway && node scripts/verify-replica-sidecar-health.mjs --repair",
    "apply:replica-migration": "npm run build:gateway && node scripts/apply-replica-migration.mjs",
    "test:replica-production-e2e": "node scripts/test-replica-production-e2e.mjs",
    "test:replica-production-e2e:http": "node scripts/test-replica-production-e2e.mjs --http",
    "test:replica-connect-flap": "node scripts/test-replica-connect-flap.mjs",
