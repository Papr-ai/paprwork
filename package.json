    "test:turso-sync-session-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-turso-sync-session-e2e.mjs",
    "test:turso-sync-overlap-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-turso-sync-overlap-e2e.mjs",
    "test:turso-bidirectional-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-turso-bidirectional-e2e.mjs",
    "test:cloud-turso-db-changed-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-cloud-turso-db-changed-e2e.mjs",
