{
  "name": "paprwork",
  "version": "2.6.0",
  "description": "AI-powered desktop assistant - Rebuilt with TypeScript and Mastra",
  "main": "./src/electron/main.cjs",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "postinstall": "npx @electron/rebuild && node scripts/patch-electron-dev-plist.mjs",
    "dev": "npm run kill:gateway && npm run build:gateway && concurrently \"npm run ui:dev\" \"npm run electron:dev\"",
    "dev:commercial": "npm run build:gateway && concurrently \"cross-env VITE_REQUIRE_PAPR_AUTH=true npm run ui:dev\" \"npm run electron:dev\"",
    "build": "npm run build:gateway && npm run build:electron && npm run build:ui",
    "build:gateway": "shx rm -rf dist/resources && shx cp -r src/resources dist/ && tsc -p tsconfig.gateway.json && tsc -p tsconfig.mini-app-sdk-node.json && shx cp src/gateway/services/appRuntime/backendDbHelper.py dist/gateway/services/appRuntime/backendDbHelper.py",
    "build:electron": "tsc -p tsconfig.electron.json && shx mkdir -p dist/electron && shx cp src/electron/preload.cjs dist/electron/preload.cjs",
    "build:ui": "cd ui && vite build",
    "build:ui:commercial": "cd ui && cross-env VITE_REQUIRE_PAPR_AUTH=true vite build",
    "start:commercial": "node scripts/ensure-electron-native.mjs && npm run build:gateway && npm run build:electron && npm run build:ui:commercial && cross-env NODE_ENV=production electron .",
    "gateway:dev": "cross-env ELECTRON_RUN_AS_NODE=1 NODE_ENV=development electron ./node_modules/tsx/dist/cli.mjs watch src/gateway/index.ts",
    "rebuild:native": "npx @electron/rebuild -f -w better-sqlite3",
    "ui:dev": "cd ui && vite",
    "electron:dev": "node scripts/patch-electron-dev-plist.mjs && cross-env NODE_ENV=development UI_DEV_URL=http://localhost:5173 electron .",
    "start": "node scripts/ensure-electron-native.mjs && cross-env NODE_ENV=production electron .",
    "start:debug": "cross-env ELECTRON_OPEN_DEVTOOLS=1 NODE_ENV=production electron .",
    "start:log": "bash scripts/start-with-logging.sh",
    "logs:view": "bash scripts/view-latest-log.sh",
    "logs:clean": "bash scripts/clean-old-logs.sh",
    "start:gateway": "node dist/gateway/index.js",
    "start:cloud-app-host": "cross-env NODE_ENV=production node --import tsx src/gateway/cloud-app-host.ts",
    "start:cloud-agent-gateway": "cross-env NODE_ENV=production GATEWAY_MODE=cloud_agent CLOUD_SYNC_ENABLED=false node --import tsx src/gateway/cloud-agent-gateway.ts",
    "start:app-repo-writer": "cross-env NODE_ENV=production node --import tsx src/gateway/app-repo-writer.ts",
    "kill:gateway": "bash scripts/kill-gateway.sh",
    "index:code": "tsx src/gateway/scripts/indexCodeToPapr.ts",
    "test:index": "tsx src/gateway/scripts/testCodeIndexing.ts",
    "test:code-search": "tsx src/gateway/scripts/testCodeSearch.ts",
    "type-check": "tsc --noEmit --project tsconfig.gateway.json && tsc --noEmit --project tsconfig.electron.json && cd ui && tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch --project tsconfig.gateway.json",
    "lint": "oxlint src ui",
    "lint:fix": "oxlint src ui --fix",
    "format": "oxfmt src ui",
    "format:check": "oxfmt src ui --check",
    "check:loc": "tsx scripts/check-max-lines.ts",
    "docs:update-papr-paths": "node scripts/update-docs-papr-paths.mjs",
    "check": "npm run type-check && npm run format:check && npm run lint && npm run check:loc",
    "test": "vitest run --project unit-backend --project unit-ui --project integration --reporter=dot --silent",
    "test:stack": "node scripts/test-stack.mjs",
    "test:stack:smoke": "node scripts/test-stack.mjs smoke",
    "test:stack:smoke:full": "node scripts/test-stack.mjs smoke --full",
    "test:stack:smoke:full-local": "node scripts/test-stack.mjs smoke --full --with-memory-local",
    "test:sequential": "node scripts/run-all-tests-sequential.mjs",
    "test:unit": "vitest run --project unit-backend --reporter=verbose",
    "test:ui": "vitest run --project unit-ui --reporter=verbose",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:e2e": "npm run build && vitest run --project e2e --reporter=verbose",
    "test:all": "npm run test && npm run test:e2e",
    "test:report": "vitest run --project unit-backend --project unit-ui --project integration --reporter=verbose --reporter=json --outputFile=test-results/results.json",
    "test:coverage": "vitest run --project unit-backend --project unit-ui --coverage --reporter=verbose",
    "test:watch": "vitest --project unit-backend --project unit-ui --reporter=verbose",
    "test:perf": "node scripts/run-perf-tests.mjs",
    "test:llm-streaming": "tsx tests/llm-streaming.test.ts",
    "test:jobs-e2e": "node scripts/test-jobs-e2e.mjs",
    "test:fd-ebadf-repro": "node --import tsx scripts/test-fd-ebadf-repro.mjs",
    "test:fd-ebadf-gateway-e2e": "node scripts/test-fd-ebadf-gateway-e2e.mjs",
    "test:jobs-advanced": "node scripts/test-jobs-advanced.mjs",
    "test:platform-connect": "node scripts/test-platform-connect-e2e.mjs",
    "test:independent-databases": "vitest run tests/independent-databases.test.ts tests/database-promotion.test.ts tests/app-backend-database.test.ts tests/job-events-sse-filter.test.ts tests/cloud-papr-path.test.ts --project unit-backend",
    "test:independent-databases-e2e": "node --import tsx scripts/test-independent-databases-e2e.mjs",
    "migrate:databases-registry": "node --import tsx scripts/migrate-databases-registry.mjs",
    "repair:data-sources": "node --import tsx scripts/repair-data-source-paths.mjs",
    "repair:post-migration": "node --import tsx scripts/repair-post-migration.mjs",
    "test:key-similarity": "npx tsx scripts/test-key-similarity.mjs",
    "test:papr-sdk": "node scripts/test-papr-sdk-update.mjs",
    "test:papr-sync-tiers": "node --import tsx scripts/test-papr-sync-tiers.mjs",
    "test:profile-photo-sync-e2e": "node --import tsx scripts/test-profile-photo-sync-e2e.mjs",
    "test:list-providers": "node scripts/test-list-providers.mjs",
    "verify:papr-tools": "node scripts/verify-papr-tools.mjs",
    "test:schema-types": "node scripts/test-schema-distinction.mjs",
    "test:browser-tools": "node scripts/test-browser-tools-e2e.mjs",
    "test:sleep-wake": "node scripts/test-sleep-wake.mjs",
    "test:sleep-wiki-queries": "node scripts/validate-sleep-wiki-queries.mjs",
    "test:memory-graph-read": "node --import tsx scripts/validate-memory-graph-read.mjs",
    "test:hybrid-search": "node scripts/test-hybrid-search.mjs",
    "test:web-search": "node scripts/test-web-search.mjs",
    "test:default-app": "node scripts/test-default-app-install.mjs",
    "prune:turso": "node scripts/prune-turso-databases.mjs",
    "prune:turso:execute": "node scripts/prune-turso-databases.mjs --all-legacy --execute",
    "analyze:tool-calls": "node scripts/analyze-tool-call-redundancy.mjs",
    "test:default-job": "node scripts/test-default-job-install.mjs",
    "test:package": "node scripts/test-package-build.mjs",
    "test:package:quick": "node scripts/test-package-build.mjs --no-package",
    "verify:release": "node scripts/verify-release-assets.mjs",
    "test:packaged-app": "pkill -f 'Electron.*Papr Work' 2>/dev/null; sleep 1; open 'release/mac-arm64/Papr Work.app'",
    "test:schema-registration": "node scripts/test-schema-registration.mjs",
    "test:cloud-e2e": "node scripts/test-cloud-e2e.mjs",
    "test:cloud-sync": "node scripts/test-cloud-sync-e2e.mjs",
    "test:cloud-app-host": "node scripts/test-cloud-app-host-e2e.mjs",
    "test:cloud-app-host-phases-2-4": "node scripts/test-cloud-app-host-phases-2-4-e2e.mjs",
    "test:plan-a-turso-direct-e2e": "npm run build:gateway && node scripts/test-plan-a-turso-direct-e2e.mjs",
    "test:desktop-session-bridge": "node scripts/test-desktop-session-bridge.mjs",
    "test:cloud-app-backend": "node scripts/test-cloud-app-backend-e2e.mjs",
    "test:cloud-bash-run": "node scripts/test-cloud-bash-run-e2e.mjs",
    "test:cloud-publish-permissions": "node scripts/test-cloud-publish-permissions-e2e.mjs",
    "test:require-sign-in-e2e": "node scripts/test-require-sign-in-e2e.mjs --cleanup",
    "test:cloud-community-install": "node scripts/test-cloud-community-install-e2e.mjs",
    "test:contribute-back-e2e": "node scripts/test-contribute-back-e2e.mjs",
    "test:cloud-track-install": "node scripts/test-cloud-track-install-e2e.mjs",
    "test:cloud-track-two-user": "node scripts/test-cloud-track-two-user-e2e.mjs",
    "test:track-pull-on-publish-e2e": "node scripts/test-track-pull-on-publish-e2e.mjs",
    "test:flush-web-ready-e2e": "npm run build:gateway && ELECTRON_RUN_AS_NODE=1 ./node_modules/.bin/electron scripts/test-flush-web-ready-e2e.mjs",
    "test:sync-phase4-5-e2e": "npm run test:flush-web-ready-e2e --",
    "test:cloud-runtime": "node scripts/test-cloud-runtime-phase.mjs",
    "test:sync-v3-e2e": "node scripts/test-sync-v3-e2e.mjs",
    "test:sync-v3-write-optimizations-e2e": "node scripts/test-sync-v3-write-optimizations-e2e.mjs",
    "test:cloud-db-perf-e2e": "node scripts/test-cloud-db-perf-e2e.mjs",
    "test:scheduler-execution-capability-e2e": "node --import tsx scripts/test-scheduler-execution-capability-e2e.mjs",
