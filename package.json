{
  "name": "paprwork",
  "version": "2.0.21",
  "description": "AI-powered desktop assistant - Rebuilt with TypeScript and Mastra",
  "main": "./src/electron/main.cjs",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "postinstall": "npx @electron/rebuild",
    "dev": "concurrently \"npm run gateway:dev\" \"npm run ui:dev\" \"npm run electron:dev\"",
    "build": "npm run build:gateway && npm run build:electron && npm run build:ui",
    "build:gateway": "tsc -p tsconfig.gateway.json && shx cp -r src/resources dist/",
    "build:electron": "tsc -p tsconfig.electron.json && shx mkdir -p dist/electron && shx cp src/electron/preload.cjs dist/electron/preload.cjs",
    "build:ui": "cd ui && vite build",
    "gateway:dev": "cross-env NODE_ENV=development tsx watch src/gateway/index.ts",
    "ui:dev": "cd ui && vite",
    "electron:dev": "cross-env NODE_ENV=development UI_DEV_URL=http://localhost:5173 electron .",
    "start": "cross-env NODE_ENV=production electron .",
    "start:debug": "cross-env ELECTRON_OPEN_DEVTOOLS=1 NODE_ENV=production electron .",
    "start:gateway": "node dist/gateway/index.js",
    "kill:gateway": "bash scripts/kill-gateway.sh",
    "index:code": "tsx src/gateway/scripts/indexCodeToPapr.ts",
    "test:index": "tsx src/gateway/scripts/testCodeIndexing.ts",
    "test:code-search": "tsx src/gateway/scripts/testCodeSearch.ts",
    "type-check": "tsc --noEmit --project tsconfig.gateway.json && tsc --noEmit --project tsconfig.electron.json && cd ui && tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "oxlint src ui",
    "lint:fix": "oxlint src ui --fix",
    "format": "oxfmt src ui",
    "format:check": "oxfmt src ui --check",
    "check:loc": "tsx scripts/check-max-lines.ts",
    "check": "npm run type-check && npm run format:check && npm run lint && npm run check:loc",
    "test": "vitest run --project unit-backend --project unit-ui --project integration --reporter=verbose",
    "test:unit": "vitest run --project unit-backend --reporter=verbose",
    "test:ui": "vitest run --project unit-ui --reporter=verbose",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:e2e": "npm run build && vitest run --project e2e --reporter=verbose",
    "test:all": "npm run test && npm run test:e2e",
    "test:report": "vitest run --project unit-backend --project unit-ui --project integration --reporter=verbose --reporter=json --outputFile=test-results/results.json",
    "test:coverage": "vitest run --project unit-backend --project unit-ui --coverage --reporter=verbose",
    "test:watch": "vitest --project unit-backend --project unit-ui --reporter=verbose",
    "test:perf": "node scripts/run-perf-tests.mjs",
    "test:llm-streaming": "tsx tests/llm-streaming.test.ts",
    "test:jobs-e2e": "node scripts/test-jobs-e2e.mjs",
    "test:jobs-advanced": "node scripts/test-jobs-advanced.mjs",
    "test:browser-tools": "node scripts/test-browser-tools-e2e.mjs",
    "test:sleep-wake": "node scripts/test-sleep-wake.mjs",
    "test:hybrid-search": "node scripts/test-hybrid-search.mjs",
    "test:web-search": "node scripts/test-web-search.mjs",
    "test:default-app": "node scripts/test-default-app-install.mjs",
    "test:default-job": "node scripts/test-default-job-install.mjs",
    "test:package": "node scripts/test-package-build.mjs",
    "test:package:quick": "node scripts/test-package-build.mjs --no-package",
    "test:packaged-app": "pkill -f 'Electron.*Papr Work' 2>/dev/null; sleep 1; open 'release/mac-arm64/Papr Work.app'",
    "test:schema-registration": "node scripts/test-schema-registration.mjs",
    "fix-app-icons": "node scripts/fix-app-icons.mjs",
    "set-home-app": "node scripts/set-default-home-app.mjs",
    "migrate:v1": "tsx scripts/migrate-v1-data.ts",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "keywords": [
    "electron",
    "ai",
    "assistant",
    "typescript",
    "mastra",
    "claude",
    "openai"
  ],
  "author": "Amir Kabbara <amir@papr.ai> (https://github.com/amirkabbara)",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.55",
    "@ai-sdk/openai": "^3.0.49",
    "@mariozechner/pi-ai": "^0.64.0",
    "@mastra/core": "^1.4.0",
    "@papr/memory": "^2.0.0",
    "@tiptap/extension-bubble-menu": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^6.0.89",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "cron-parser": "^5.5.0",
    "docx": "^9.5.2",
    "electron-ollama": "^0.1.25",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "mammoth": "^1.11.0",
    "ollama-ai-provider-v2": "^3.3.1",
    "playwright": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.2",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "zod": "^4.1.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron": "^1.6.12",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.1.9",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.4",
    "electron": "^40.3.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "empty-module": "^0.0.2",
    "happy-dom": "^17.6.1",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.13.0",
    "oxlint": "^0.13.0",
    "playwright": "^1.40.0",
    "shx": "^0.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^2.1.9"
  }
}
