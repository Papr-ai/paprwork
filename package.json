    "test:sync-v3-e2e:p0": "node scripts/test-sync-v3-e2e.mjs",
    "test:sync-v3-e2e:partial": "node scripts/test-sync-v3-e2e.mjs --allow-partial",
    "test:sync-v3-e2e:comprehensive": "vitest run tests/replay-safe-sql.test.ts tests/writer-outbox-errors.test.ts tests/sync-v3-heartbeat.test.ts tests/workspace-log-replay.test.ts --project unit-backend --reporter=verbose --fileParallelism=false && node scripts/test-sync-v3-e2e.mjs",
    "test:sync-v3-concurrency-e2e": "npm run build:gateway && node scripts/test-sync-v3-concurrency-e2e.mjs",
    "test:sync-v3-e2e:vitest": "vitest run --project e2e --reporter=verbose test/e2e/sync-v3.e2e.test.ts",
    "genesis:workspace-log": "node --import tsx scripts/run-workspace-log-genesis-cutover.mjs",
    "backfill:migration-ledgers": "node --import tsx scripts/backfill-migration-ledgers.mjs",
    "backfill:migration-ledgers:keychain": "electron scripts/run-backfill-migration-ledgers-with-keychain.mjs",
    "probe:joe-turso": "electron scripts/run-probe-joe-turso-with-keychain.mjs",
    "fixtures:capture-workspace-log": "node scripts/capture-workspace-log-fixtures.mjs",
    "test:sync-v3-writer": "vitest run tests/app-repo-writer-ops.test.ts tests/sync-v3-writer-client.test.ts --project unit-backend --reporter=verbose",
    "test:app-repo-writer": "node scripts/test-app-repo-writer-health.mjs",
