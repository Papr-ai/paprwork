              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entity_id",
          "score",
          "record"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "Sort": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "order": {
            "default": "desc",
            "enum": [
              "asc",
              "desc"
            ],
            "title": "Order",
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "title": "Sort",
        "type": "object"
      },
      "TaskData": {
        "properties": {
          "entities": {
            "items": {
              "type": "string"
            },
            "title": "Entities",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "retry_after_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hint while queued or running.",
            "title": "Retry After S"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "done",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "state",
          "entities"
        ],
        "title": "TaskData",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Why": {
        "properties": {
          "filters_matched": {
            "items": {
              "type": "string"
            },
            "title": "Filters Matched",
            "type": "array"
          },
          "matched_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Text"
          },
          "seed_overlap": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed Overlap"
          }
        },
        "title": "Why",
        "type": "object"
      }
    }
  },
