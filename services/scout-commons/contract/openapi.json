      },
      "SearchResult": {
        "properties": {
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          },
          "record": {
            "additionalProperties": true,
            "description": "Requested fields + every Freshness field.",
            "title": "Record",
            "type": "object"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "why": {
            "anyOf": [
