# Paprwork V2 - Environment Variables
# Copy this file to .env.local and add your API keys

# ============================================
# AI Provider API Keys (Required)
# ============================================

# Anthropic (Claude) - Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT) - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google (Gemini) - Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ============================================
# Papr Memory (Optional but Recommended)
# ============================================
# Enables chat history, summarization, and memory features
# Get your API key from: https://dashboard.papr.ai
# OR login via Paprwork's "Login to Papr" button for automatic provisioning

PAPR_API_KEY=your_papr_api_key_here

# Papr Platform Configuration (for automatic login)
# Default: https://dashboard.papr.ai
# PAPR_PLATFORM_URL=https://dashboard.papr.ai

# ============================================
# Build Configuration (Commercial vs Open Source)
# ============================================
# Set to 'true' for commercial downloadable builds (requires Papr authentication)
# Set to 'false' for open-source builds (Papr authentication optional)
# Default: false (open source mode)
# NOTE: Must use VITE_ prefix for Vite to expose to client code
VITE_REQUIRE_PAPR_AUTH=false

# ============================================
# Additional Configuration (Optional)
# ============================================

# Gateway WebSocket port (default: 18789)
# GATEWAY_PORT=18789

# Development mode settings
# NODE_ENV=development
