# Paprwork V2 - Environment Variables
# Copy this file to .env.local and add your API keys

# ============================================
# AI Provider API Keys (Required)
# ============================================

# Anthropic (Claude) - Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT) - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google (Gemini) - Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ============================================
# Papr Memory (Optional but Recommended)
# ============================================
# Enables chat history, summarization, and memory features
# Get your API key from: https://dashboard.papr.ai
# OR login via Paprwork's "Login to Papr" button for automatic provisioning

PAPR_API_KEY=your_papr_api_key_here

# TypeSafe Jev (optional) — typed decisions for jev_decide
# Prefer Papr login (PAPR_API_KEY) → memory server proxy /v1/typesafe/systemone
# Or BYOK from https://console.typesafe.ai
# TYPESAFE_API_KEY=
# JEV_PROXY_PATH=/v1/typesafe/systemone
# TYPESAFE_SYSTEMONE_URL=https://api.typesafe.ai/v1/systemone

# Optional: ad-hoc / E2E test scripts (scripts/test-*, test-papr-*.mjs)
# PAPR_TEST_CHAT_ID=your-session-id
# PAPR_MEMORY_SERVER_URL=http://localhost:5001

# App-repo-writer — defaults to the Papr Cloud writer, so leave unset unless you
# are running the writer locally (npm run start:app-repo-writer).
# See docs/SYNC_V3_ENV.md
# PAPR_APP_REPO_WRITER_URL=http://127.0.0.1:8789
# PARSE_SERVER_URL=https://api.papr.ai
# PARSE_APPLICATION_ID=your_parse_app_id
# PARSE_MASTER_KEY=your_parse_master_key

# Papr Platform Configuration (for automatic login)
# Default: https://dashboard.papr.ai
# PAPR_PLATFORM_URL=https://dashboard.papr.ai
# Team invites/members use the same URL unless you set PAPR_TEAM_PLATFORM_URL separately.
# PARSE_GRAPHQL_URL=https://server.papr.ai/graphql

# ============================================
# Build Configuration (Commercial vs Open Source)
# ============================================
# Set to 'true' for commercial downloadable builds (requires Papr authentication)
# Set to 'false' for open-source builds (Papr authentication optional)
# Default: false (open source mode)
# NOTE: Vite requires VITE_ prefix for client code. REQUIRE_PAPR_AUTH is also accepted as an alias.
VITE_REQUIRE_PAPR_AUTH=false
# REQUIRE_PAPR_AUTH=true

# Cloud App Host ↔ Memory shared secret (desktop notify + local cloud-app-host dogfood)
# Packaged releases: defaults in src/resources/packaged-gateway-env.defaults.json
# GitHub secrets (optional overrides): PAPR_APP_REPO_WRITER_URL, PAPR_CLOUD_APP_HOST_KEY, PAPR_MEMORY_SERVER_URL
# PAPR_CLOUD_APP_HOST_KEY=
# Optional: GCS bucket for cross-instance repo-file cache (deploy script creates {project}-cloud-app-host-cache)
# CLOUD_APP_HOST_GCS_BUCKET=
# Persistent Python worker for backend actions on Cloud App Host (default: on in production)
# CLOUD_APP_HOST_PYTHON_WORKER=1
# AUTH0_DOMAIN=papr.auth0.com
# AUTH0_CLIENT_ID=your_client_id
# Allowed Callback URLs must include: http://127.0.0.1:18791/auth/callback
# Fallback deep link (legacy): papr://auth/callback
# PAPR_AUTH_USE_DEEPLINK=true
# Optional: open browser on logout to clear Auth0 session (must be whitelisted in
# Auth0 dashboard → Application → Allowed Logout URLs). Leave unset for desktop UX.
# AUTH0_LOGOUT_RETURN_TO=https://papr.ai/logged-out

# ============================================
# Platform Feedback (dev only — do NOT ship in releases)
# ============================================
# Local gateway fallback when memory server feedback API is unavailable.
# Production uses POST /v1/platform-feedback/issues on memory server (Papr login).
# PAPR_GITHUB_ISSUE_TOKEN=ghp_...

# ============================================
# Additional Configuration (Optional)
# ============================================

# Gateway WebSocket port (default: 18789)
# GATEWAY_PORT=18789

# Development mode settings
# NODE_ENV=development

# Gateway cold-start timing (per-service + route-section ms, summary at gatewayReady)
# GATEWAY_STARTUP_TIMING=1

# Gateway background planes (Phase C/D — see docs/GATEWAY_PLANES_AND_PHASES.md)
# GATEWAY_BACKGROUND_PROCESS=0
# GATEWAY_BG_MAX_CONCURRENCY=2
# GATEWAY_BG_QUIET_MS=1500
# GATEWAY_BG_MAX_WAIT_MS=120000
# GATEWAY_BG_DEFER_EVENT_LOOP_MS=1500
# DB_QUERY_POOL_SIZE=2
# CODE_INDEX_IO_POOL_SIZE=2

# Mini-app replica reads (defaults: 5000 / 15000 / 5000 ms)
# REPLICA_MINI_APP_READ_TIMEOUT_MS=5000
# REPLICA_MINI_APP_READ_RETRY_TIMEOUT_MS=15000
# After app open: replica-only reads (no Turso primary race) for first N ms
# MINI_APP_LOAD_WINDOW_MS=20000
# MINI_APP_LOAD_REPLICA_ONLY=false  # disable replica-only during load window
# Defer replica push while mini-app/chat hot path is active (manual push exempt)
# TURSO_PUSH_DEFER_WHILE_INTERACTIVE=false
# REPLICA_DEGRADED_LOCAL_READ_TIMEOUT_MS=5000
# Replica path queue: default allows parallel reads during background pull (Turso SDK behaviour).
# Set to 1 to restore legacy one-op-at-a-time per data.db path.
# PAPR_REPLICA_STRICT_PATH_QUEUE=1
# PAPR_REPLICA_MAX_PARALLEL_READS=16
# PAPR_REPLICA_READ_DURING_SYNC=1  # read while pull runs (can wedge worker — off by default)
# REPLICA_READ_TRACE=1  # log gatewayPathQueueMs / workerQueueMs per mini-app read
# MINI_APP_STATIC_SLOW_MS=500  # log /apps/:id/* when handler total exceeds this (ms)
# MINI_APP_STATIC_TRACE=1  # log every mini-app static request (not just index.html / dist/app.js)
# Loopback read cache for /api/db/query (default 8000 ms)
# LOCAL_DB_READ_CACHE_TTL_MS=8000
# Defer starting Turso replica push while chat/apps active (defaults: 1500 / 60000 ms)
# TURSO_PUSH_YIELD_QUIET_MS=1500
# TURSO_PUSH_YIELD_MAX_WAIT_MS=60000

# Turso: workspace sync-index reconcile on startup (default off — use heartbeat + app-open)
# TURSO_STARTUP_SYNC_INDEX=true
# TURSO_STARTUP_DELAY_MS=15000
# (Removed) GOALS_PROJECTION_BOOT_DELAY_MS — deferred home boot uses gateway-deferred-boot.json epoch gating instead.

# Stream latency profiling (prints step-by-step timing tables in gateway logs)
# PAPR_STREAM_PROFILE=1
# VITE_PAPR_STREAM_PROFILE=1
# Or in DevTools console: localStorage.setItem('PAPR_STREAM_PROFILE', '1')

# Cloud agent sandbox writer debounce (mirrors Turso debouncer)
# CLOUD_AGENT_WRITER_DEBOUNCE_MS=15000
# CLOUD_AGENT_WRITER_MAX_WAIT_MS=120000
