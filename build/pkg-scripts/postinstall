#!/bin/bash
# Post-install for Papr Work PKG — chown bundle for ShipIt, then open as console user.
set +e

APP_PATH="/Applications/Papr Work.app"
LABEL="com.paprwork.v2.open-after-install"
LOG="/var/log/paprwork-postinstall.log"

log() {
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >>"$LOG" 2>/dev/null || true
}

console_user() {
  local u
  u="$(/usr/sbin/scutil <<<"show State:/Users/ConsoleUser" 2>/dev/null | awk '/Name :/ { print $3 }')"
  if [ -n "$u" ] && [ "$u" != "loginwindow" ] && [ "$u" != "_mbsetupuser" ]; then
    echo "$u"
    return 0
  fi
  u="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)"
  if [ -n "$u" ] && [ "$u" != "root" ] && [ "$u" != "loginwindow" ]; then
    echo "$u"
  fi
}

user_home() {
  local u="$1"
  local home
  home="$(/usr/bin/dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  if [ -n "$home" ] && [ -d "$home" ]; then
    echo "$home"
  else
    echo "/Users/$u"
  fi
}

launch_for_user() {
  local u="$1"
  local uid home agent_dir plist

  uid="$(/usr/bin/id -u "$u" 2>/dev/null)"
  if [ -z "$uid" ]; then
    log "no uid for $u"
    return 1
  fi

  home="$(user_home "$u")"
  agent_dir="$home/Library/LaunchAgents"
  plist="$agent_dir/${LABEL}.plist"

  /bin/mkdir -p "$agent_dir"
  /usr/bin/chown "$u:staff" "$agent_dir" 2>/dev/null

  /bin/cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/open</string>
    <string>${APP_PATH}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
</dict>
</plist>
EOF

  /usr/sbin/chown "$u:staff" "$plist"
  /bin/chmod 644 "$plist"

  log "launchctl bootstrap gui/$uid for $u"
  if /bin/launchctl bootstrap "gui/$uid" "$plist" >>"$LOG" 2>&1; then
    /bin/sleep 2
    /bin/launchctl bootout "gui/$uid" "$plist" >>"$LOG" 2>&1 || true
    /bin/rm -f "$plist"
    return 0
  fi

  log "bootstrap failed; trying open as user"
  /usr/bin/sudo -u "$u" env HOME="$home" USER="$u" /usr/bin/open "$APP_PATH" >>"$LOG" 2>&1
}

log "postinstall start"

if [ ! -d "$APP_PATH" ]; then
  log "missing $APP_PATH"
  exit 0
fi

CONSOLE_USER="$(console_user)"
log "console user=${CONSOLE_USER:-none}"

if [ -n "$CONSOLE_USER" ]; then
  /usr/sbin/chown -R "$CONSOLE_USER:staff" "$APP_PATH" 2>/dev/null
fi

/bin/sleep 1

if [ -n "$CONSOLE_USER" ]; then
  launch_for_user "$CONSOLE_USER"
else
  /usr/bin/open "$APP_PATH" >>"$LOG" 2>&1 || true
fi

log "postinstall done"
exit 0
