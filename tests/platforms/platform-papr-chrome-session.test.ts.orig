import { describe, expect, it, vi, beforeEach } from "vitest";

const spawnMock = vi.fn();
const connectMock = vi.fn();

vi.mock("../../src/gateway/services/platforms/platformDirectChromeSpawn.js", () => ({
  isCdpAttachUnsupportedError: (err: Error) => /Browser\.setDownloadBehavior|context management is not supported|Timeout \d+ms exceeded/i.test(err.message),
  isChromeUsingUserDataDir: vi.fn().mockReturnValue(false),
  isPlatformCdpReady: vi.fn().mockResolvedValue(true),
  resolvePlatformCdpPort: vi.fn().mockReturnValue(9222),
  buildPlatformCdpUrl: vi.fn().mockReturnValue("http://127.0.0.1:9222"),
  spawnDirectGoogleChrome: spawnMock
}));

vi.mock("playwright", () => ({
  chromium: {
    connectOverCDP: connectMock
  }
}));

vi.mock("../../src/gateway/services/platforms/platformPaprChromeProfile.js", () => ({
  getSharedPaprChromeUserDataDir: vi.fn().mockReturnValue("/mock/dir"),
  findPlatformIdForUrl: vi.fn().mockReturnValue(null),
  hostnameMatchesPlatform: vi.fn().mockReturnValue(false),
  pickBestPageForPlatform: vi.fn().mockReturnValue(null)
}));

import { ensurePaprChromeBrowser } from "../../src/gateway/services/platforms/platformPaprChromeSession.js";

describe("ensurePaprChromeBrowser CDP attachment", () => {
  const contextMock = {
    pages: vi.fn().mockReturnValue([]),
    browser: vi.fn().mockReturnValue({ isConnected: () => true })
  };

  beforeEach(() => {
    vi.clearAllMocks();
    connectMock.mockResolvedValue({
      contexts: () => [contextMock]
    });
  });

  it("restarts Chrome and retries on timeout error", async () => {
    spawnMock.mockResolvedValue({ cdpUrl: "http://127.0.0.1:9222" });
    
    // First try times out
    connectMock.mockRejectedValueOnce(new Error("Timeout 30000ms exceeded"));
    
    const result = await ensurePaprChromeBrowser();
    
    expect(spawnMock).toHaveBeenCalledTimes(2);
    expect(spawnMock).toHaveBeenLastCalledWith(expect.objectContaining({ forceRespawn: true }));
    expect(result.context).toBe(contextMock);
  });

  it("passes through unknown CDP attach errors", async () => {
    spawnMock.mockResolvedValue({ cdpUrl: "http://127.0.0.1:9222" });
    connectMock.mockRejectedValue(new Error("Connection refused"));
    
    await expect(ensurePaprChromeBrowser()).rejects.toThrow("Connection refused");
    expect(spawnMock).toHaveBeenCalledTimes(1);
  });
});
