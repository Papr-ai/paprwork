# Copy to .env.development, then: npm run dev:devenv
# Runs "Papr Work Dev" against the development backend, with its own
# workspace (~/Papr-dev, ~/.paprwork-v2-dev) — production data is untouched.

PAPR_MEMORY_SERVER_URL=https://memoryserver-development-7dckb3v3oa-uw.a.run.app
PARSE_SERVER_URL=https://parseserver-development-223473570766.us-west1.run.app/parse
PARSE_GRAPHQL_URL=https://parseserver-development-223473570766.us-west1.run.app/graphql

# Development Auth0 tenant — "Papr macOS Development" native app (public PKCE
# client, callback papr://auth/callback already allowed).
AUTH0_DOMAIN=papr-development.auth0.com
AUTH0_CLIENT_ID=8MUWN8YrzTRReIJKxUuoZTOY179f85qg
