{
  "name": "@splitin/outreach-contracts",
  "version": "0.0.0",
  "description": "Provider-neutral outreach contracts: types, schemas, action state table, error taxonomy.",
  "license": "MIT",
  "author": "SplitInTech",
  "homepage": "https://github.com/splitintech/open-internal-tools/tree/main/outreach-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/open-internal-tools.git",
    "directory": "outreach-engine/packages/outreach-contracts"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.13" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
